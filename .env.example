# Discord OAuth application. Keep the Client Secret private.
DISCORD_CLIENT_ID=1531476186470023281
DISCORD_CLIENT_SECRET=PASTE_SECRET_HERE
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# Tower Eclipse Discord server and mapped roles.
DISCORD_GUILD_ID=1220113679673196624
DISCORD_ROLE_LEADQA_ID=1368443378022223923
DISCORD_ROLE_QA_ID=1227958798333906966
DISCORD_ROLE_DEV_ID=1225365211406405711

# Local website and secure server-side session signing.
APP_ORIGIN=http://localhost:5173
COOKIE_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Firebase Admin SDK. Keep the service-account JSON outside this project.
FIREBASE_PROJECT_ID=tower-eclipse-bug-reports
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json # <-- firebase admin key

NODE_ENV=development
PORT=3001
SESSION_TTL_HOURS=8
ROLE_RECHECK_SECONDS=300
